<?xml version="1.0" encoding="utf-8"?>
<!--
    AlterLingua will hold private learning data, so nothing is copied to cloud backup or to a new
    phone during device transfer. A later milestone can opt specific data in on purpose.
    Applies to Android 12 and higher; android:allowBackup="false" covers older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
