<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:networkSecurityConfig="@xml/network_security_config">
        <!--
            DEBUG BUILDS ONLY. Lets `adb` post a WhatsApp-shaped test message so incoming translation can be tried
            without a second phone (see docs/progress.md). Release builds contain no such receiver.
        -->
        <receiver
            android:name=".notifications.DebugTestMessageReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.alterlingua.app.DEBUG_TEST_MESSAGE" />
            </intent-filter>
        </receiver>

        <!--
            DEBUG BUILDS ONLY. Lets `adb` fire the "Voice note captured" notification (through the Settings switch) without
            playing a voice note. Release builds contain no such receiver.
        -->
        <receiver
            android:name=".capture.DebugCapturedNoteReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.alterlingua.app.DEBUG_CAPTURED_NOTE" />
            </intent-filter>
        </receiver>

        <!--
            DEBUG BUILDS ONLY. Lets `adb` set the subscription tier directly, so Standard/Premium-gated features can
            be tried on a real device before real Google Play Billing products exist. Release builds contain no
            such receiver.
        -->
        <receiver
            android:name=".entitlements.DebugTierReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.alterlingua.app.DEBUG_SET_TIER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
