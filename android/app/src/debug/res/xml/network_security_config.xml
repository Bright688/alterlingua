<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG BUILDS ONLY. Android blocks plain HTTP by default. This allows it for the phone's own loopback address
    (used with `adb reverse`) and the emulator's alias for the host computer, and nothing else. Release builds have
    no such file, so they only ever use HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
