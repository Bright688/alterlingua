# Copy to .env for local use. .env is git-ignored: never commit real values.
# Every variable starts with ALTERLINGUA_.

ALTERLINGUA_ENVIRONMENT=development
ALTERLINGUA_LOG_LEVEL=INFO

# "fake" is a development stand-in that is NOT a real translator. Real options: "mistral", "groq", "cloudflare", or
# "fallback" (Groq first, Cloudflare Workers AI if Groq fails or has no key configured).
ALTERLINGUA_TRANSLATION_PROVIDER=fake

# Speech-to-text provider. "fake" is a development stand-in that does NOT recognise speech (it ignores the audio).
# Real options: "mistral" (Voxtral), "groq" (Whisper large-v3), "cloudflare" (Whisper large-v3-turbo), or "fallback"
# (Groq first; Cloudflare if Groq fails, is out of quota, or hears nothing). Uses the same Groq / Cloudflare keys as translation.
ALTERLINGUA_STT_PROVIDER=fake
# ALTERLINGUA_GROQ_STT_MODEL=whisper-large-v3
# ALTERLINGUA_CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo

# Largest audio upload in bytes (default 10 MiB), how long to wait for speech recognition (seconds), and where
# temporary audio is written while it is processed (empty = the system temp folder). Audio is deleted right after.
ALTERLINGUA_MAX_AUDIO_BYTES=10485760
ALTERLINGUA_STT_TIMEOUT_SECONDS=60
ALTERLINGUA_TTS_PROVIDER=fake
ALTERLINGUA_TTS_TIMEOUT_SECONDS=60
ALTERLINGUA_MAX_TTS_CHARS=1500
ALTERLINGUA_TEMP_DIR=

# Longest accepted text in Unicode characters, and how long to wait for the provider (seconds). With
# ALTERLINGUA_TRANSLATION_PROVIDER=fallback this budget covers every leg tried, not just the first.
ALTERLINGUA_MAX_TEXT_CHARS=5000
ALTERLINGUA_PROVIDER_TIMEOUT_SECONDS=15

# Mistral AI (used by "mistral", or as the fallback leg of "fallback"). Never put a real key in this file.
# ALTERLINGUA_MISTRAL_API_KEY=
# Voice ids for text-to-speech, JSON language-code -> Mistral voice id (there is no server-side default voice;
# call GET /v1/audio/voices with your key to see what your account actually has). Example:
# ALTERLINGUA_MISTRAL_TTS_VOICES={"en": "en_paul_neutral"}

# Groq (used by "groq", or as the primary leg of "fallback"). Never put a real key in this file.
# ALTERLINGUA_GROQ_API_KEY=
# ALTERLINGUA_GROQ_TRANSLATION_MODEL=openai/gpt-oss-120b
# Second Groq model tried when the first has used its own free daily allowance (200,000 tokens/day each); empty leaves it out.
# ALTERLINGUA_GROQ_TRANSLATION_FALLBACK_MODEL=openai/gpt-oss-20b
# How hard the gpt-oss models think: "low" spends about a third fewer tokens per translation. Empty sends nothing.
# ALTERLINGUA_GROQ_REASONING_EFFORT=low

# Cloudflare Workers AI (used by "cloudflare", or as the fallback leg of "fallback"). Needs both a token and an
# account id (found in the Cloudflare dashboard). Never put real values in this file.
# ALTERLINGUA_CLOUDFLARE_API_TOKEN=
# ALTERLINGUA_CLOUDFLARE_ACCOUNT_ID=
# ALTERLINGUA_CLOUDFLARE_TRANSLATION_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
